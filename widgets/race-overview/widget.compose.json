{
  "name": {
    "en": "F1 Race Overview",
    "nl": "F1 Race Overzicht"
  },
  "description": {
    "en": "Pick a race and show selected details. Turns red when finished and shows winner (when available).",
    "nl": "Kies een race en toon geselecteerde details. Wordt rood als de race voorbij is en toont de winnaar (als beschikbaar)."
  },
  "settings": [
    {
      "id": "defaultRound",
      "type": "number",
      "label": {
        "en": "Default round",
        "nl": "Standaard ronde"
      },
      "value": 1,
      "min": 1,
      "max": 30
    },
    {
      "id": "autoRefreshSeconds",
      "type": "number",
      "label": {
        "en": "Auto refresh (seconds)",
        "nl": "Auto refresh (seconden)"
      },
      "value": 60,
      "min": 10,
      "max": 3600
    },
    {
      "id": "show_gpName",
      "type": "boolean",
      "label": {
        "en": "Show Grand Prix name",
        "nl": "Toon Grand Prix naam"
      },
      "value": true
    },
    {
      "id": "show_raceTime",
      "type": "boolean",
      "label": {
        "en": "Show race time",
        "nl": "Toon race tijd"
      },
      "value": true
    },
    {
      "id": "show_country",
      "type": "boolean",
      "label": {
        "en": "Show country",
        "nl": "Toon land"
      },
      "value": true
    },
    {
      "id": "show_city",
      "type": "boolean",
      "label": {
        "en": "Show city",
        "nl": "Toon stad"
      },
      "value": true
    },
    {
      "id": "show_circuit",
      "type": "boolean",
      "label": {
        "en": "Show circuit",
        "nl": "Toon circuit"
      },
      "value": true
    },
    {
      "id": "show_fp1",
      "type": "boolean",
      "label": {
        "en": "Show FP1",
        "nl": "Toon VT1"
      },
      "value": true
    },
    {
      "id": "show_fp2orSQ",
      "type": "boolean",
      "label": {
        "en": "Show FP2 or Sprint Qualifying",
        "nl": "Toon VT2 of Sprint kwalificatie"
      },
      "value": true
    },
    {
      "id": "show_fp3orSprint",
      "type": "boolean",
      "label": {
        "en": "Show FP3 or Sprint",
        "nl": "Toon VT3 of Sprint"
      },
      "value": true
    },
    {
      "id": "show_quali",
      "type": "boolean",
      "label": {
        "en": "Show Qualifying",
        "nl": "Toon kwalificatie"
      },
      "value": true
    },
    {
      "id": "show_winner",
      "type": "boolean",
      "label": {
        "en": "Show winner (when finished)",
        "nl": "Toon winnaar (na race)"
      },
      "value": true
    }
  ]
}
