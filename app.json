{
  "id": "com.darqeth.f1tracker",
  "version": "1.1.0",
  "compatibility": ">=12.1.0",
  "sdk": 3,
  "name": {
    "en": "F1 Tracker Pro",
    "nl": "F1 Tracker Pro"
  },
  "icon": "/assets/icon.svg",
  "description": {
    "en": "Your Homey co-pilot for Formula 1. Session alerts, live countdown, season calendar and standings — all on your dashboard.",
    "nl": "Jouw Homey-copiloot voor Formule 1. Sessie-alerts, live afteltimer, seizoenskalender en klassementen op je dashboard."
  },
  "category": "tools",
  "author": {
    "name": "Mark",
    "website": "https://www.byhim.nl"
  },
  "support": "https://www.byhim.nl",
  "homepage": "https://www.byhim.nl",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "brandColor": "#D80000",
  "settings": [
    {
      "id": "season",
      "type": "dropdown",
      "title": {
        "en": "Season",
        "nl": "Seizoen"
      },
      "value": "current",
      "values": [
        {
          "id": "current",
          "title": {
            "en": "Current",
            "nl": "Huidig"
          }
        },
        {
          "id": "2026",
          "title": {
            "en": "2026",
            "nl": "2026"
          }
        },
        {
          "id": "2025",
          "title": {
            "en": "2025",
            "nl": "2025"
          }
        }
      ]
    },
    {
      "id": "schedule_cache_hours",
      "type": "number",
      "title": {
        "en": "Cache duration (hours)",
        "nl": "Cacheduur (uren)"
      },
      "value": 6,
      "attr": {
        "min": 1,
        "max": 48
      }
    },
    {
      "id": "poll_seconds",
      "type": "number",
      "title": {
        "en": "Poll interval (seconds)",
        "nl": "Pollinginterval (seconden)"
      },
      "value": 30,
      "attr": {
        "min": 5,
        "max": 300
      }
    },
    {
      "id": "fast_poll_before_minutes",
      "type": "number",
      "title": {
        "en": "Fast polling threshold (minutes before session)",
        "nl": "Snel pollen tot (minuten voor sessie)"
      },
      "value": 10,
      "attr": {
        "min": 0,
        "max": 120
      }
    }
  ],
  "widgets": {
    "f1-calendar": {
      "id": "f1-calendar",
      "name": {
        "en": "F1 Calendar",
        "nl": "F1 Kalender"
      },
      "width": 2,
      "height": 500,
      "settings": [],
      "api": {
        "calendar": {
          "method": "GET",
          "path": "/calendar"
        }
      }
    },
    "f1-drivers": {
      "id": "f1-drivers",
      "name": {
        "en": "F1 Drivers",
        "nl": "F1 Rijders"
      },
      "width": 2,
      "height": 400,
      "settings": [],
      "api": {
        "standings": {
          "method": "GET",
          "path": "/standings"
        }
      }
    },
    "f1-constructors": {
      "id": "f1-constructors",
      "name": {
        "en": "F1 Constructors",
        "nl": "F1 Constructeurs"
      },
      "width": 2,
      "height": 300,
      "settings": [],
      "api": {
        "standings": {
          "method": "GET",
          "path": "/standings"
        }
      }
    },
    "f1-drivers-podium": {
      "id": "f1-drivers-podium",
      "name": {
        "en": "F1 Drivers Podium",
        "nl": "F1 Rijders Podium"
      },
      "width": 2,
      "height": 185,
      "settings": [],
      "api": {
        "standings": {
          "method": "GET",
          "path": "/standings"
        }
      }
    },
    "f1-constructors-podium": {
      "id": "f1-constructors-podium",
      "name": {
        "en": "F1 Constructors Podium",
        "nl": "F1 Constructeurs Podium"
      },
      "width": 2,
      "height": 185,
      "settings": [],
      "api": {
        "standings": {
          "method": "GET",
          "path": "/standings"
        }
      }
    },
    "f1-countdown": {
      "id": "f1-countdown",
      "name": {
        "en": "F1 Countdown",
        "nl": "F1 Aftellen"
      },
      "width": 2,
      "height": 200,
      "settings": [],
      "api": {
        "countdown": {
          "method": "GET",
          "path": "/countdown"
        }
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Free practice 1 starts in…",
          "nl": "Vrije training 1 begint over…"
        },
        "titleFormatted": {
          "en": "Free practice 1 starts in [[x]] [[unit]]",
          "nl": "Vrije training 1 begint over [[x]] [[unit]]"
        },
        "icon": "/assets/icon.svg",
        "args": [
          {
            "name": "x",
            "type": "number",
            "title": {
              "en": "X",
              "nl": "X"
            },
            "min": 0,
            "max": 99999
          },
          {
            "name": "unit",
            "type": "dropdown",
            "title": {
              "en": "Unit",
              "nl": "Tijd"
            },
            "values": [
              {
                "id": "minutes",
                "label": {
                  "en": "minutes",
                  "nl": "minuten"
                }
              },
              {
                "id": "hours",
                "label": {
                  "en": "hours",
                  "nl": "uren"
                }
              },
              {
                "id": "days",
                "label": {
                  "en": "days",
                  "nl": "dagen"
                }
              },
              {
                "id": "weeks",
                "label": {
                  "en": "weeks",
                  "nl": "weken"
                }
              }
            ]
          }
